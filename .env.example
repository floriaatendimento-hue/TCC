# FLORIA — variáveis de ambiente

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=floria

# Pool de conexões
DB_POOL_LIMIT=10
DB_POOL_QUEUE=0
DB_CONNECT_TIMEOUT=10000

# Sessão
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
SESSION_MAX_AGE_DIAS=7
SESSION_ABSOLUTO_CLIENTE_HORAS=168
SESSION_ABSOLUTO_ADMIN_HORAS=12
SESSION_IDLE_ADMIN_MINUTOS=30

# Uploads
UPLOAD_DIR=app/public/uploads/perfil
UPLOAD_MAX_MB=2
UPLOAD_AVALIACAO_IMG_MB=
UPLOAD_AVALIACAO_VIDEO_MB=
UPLOAD_PRODUTO_MB=
UPLOAD_BANNER_MB=

# Rate Limiting — login
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# Rate Limiting — cadastro
CADASTRO_MAX_TENTATIVAS=10
CADASTRO_JANELA_MINUTOS=60

# Rate Limiting — finalização de pagamento
PAGAMENTO_MAX_TENTATIVAS=20
PAGAMENTO_JANELA_MINUTOS=15

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

EMAIL_SUPORTE=
SITE_URL=http://localhost:3000

# Rate Limiting — recuperação de senha
RECUPERACAO_MAX_TENTATIVAS=5
RECUPERACAO_JANELA_MINUTOS=60

# Recuperação de senha por OTP
OTP_EXPIRA_MINUTOS=10
OTP_MAX_TENTATIVAS=5
OTP_AUTORIZACAO_MINUTOS=15
OTP_COOLDOWN_SEGUNDOS=60
OTP_MAX_SOLICITACOES_HORA=5
OTP_VERIFICAR_MAX_TENTATIVAS=10
OTP_VERIFICAR_JANELA_MINUTOS=15

TROCA_SENHA_MAX_TENTATIVAS=5
TROCA_SENHA_JANELA_MINUTOS=15

# Rate Limiting — formulário de suporte
SUPORTE_MAX_TENTATIVAS=5
SUPORTE_JANELA_MINUTOS=60

AVALIACAO_MAX_TENTATIVAS=20
AVALIACAO_JANELA_MINUTOS=15

COMPROVANTE_EMAIL_MAX_TENTATIVAS=10
COMPROVANTE_EMAIL_JANELA_MINUTOS=60
SUPORTE_RETENCAO_DIAS=730
LOGS_ADMIN_RETENCAO_DIAS=548

VIACEP_TIMEOUT_MS=5000
NOMINATIM_TIMEOUT_MS=6000
NOMINATIM_USER_AGENT=
ENDERECO_VALIDACAO_CACHE_TTL_MS=86400000

# REAIS do Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_ENVIRONMENT=test
MP_WEBHOOK_MAX_REQUISICOES=120
MP_WEBHOOK_JANELA_MINUTOS=1
MP_WEBHOOK_LOG_RETENCAO_DIAS=90
