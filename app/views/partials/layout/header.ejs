<a href="#conteudo-principal" class="skip-link">Pular para o conteúdo principal</a>
<script>
  window.__logado = !!(<%= locals.usuario ? true : false %>);
  window.__usuarioId = <%= locals.usuario ? locals.usuario.id : 'null' %>;
  window.__usuarioNome = <%- locals.usuario ? JSON.stringify(locals.usuario.nome || '').replace(/</g, '\\u003c') : "''" %>;
</script>
<input type="hidden" id="csrf-token" value="<%= csrfToken %>">
