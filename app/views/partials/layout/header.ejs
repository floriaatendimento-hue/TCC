<script>
(function () {
  try {
    var p = JSON.parse(localStorage.getItem('floria_a11y_prefs') || 'null');
    if (!p) return;
    var h = document.documentElement;
    if (p.tamanho_fonte && p.tamanho_fonte !== 'normal') h.setAttribute('data-a11y-fonte', p.tamanho_fonte);
    if (p.espacamento_texto && p.espacamento_texto !== 'normal') h.setAttribute('data-a11y-espacamento', p.espacamento_texto);
    if (p.alto_contraste) h.setAttribute('data-a11y-contraste', '1');
    if (p.reduzir_movimento) h.setAttribute('data-a11y-movimento', '1');
    if (p.destacar_links) h.setAttribute('data-a11y-links', '1');
    if (p.destacar_foco) h.setAttribute('data-a11y-foco', '1');
    if (p.interface_simplificada) h.setAttribute('data-a11y-simples', '1');
    if (p.otimizar_leitor_tela) h.setAttribute('data-a11y-leitor', '1');
    if (p.libras_ativo) h.setAttribute('data-a11y-libras', '1');
  } catch (e) {}
})();
</script>
