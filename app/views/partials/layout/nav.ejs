<section class="drawer-overlay" id="drawer-overlay" hidden></section>

<nav class="drawer-menu" id="drawer-menu" aria-label="Menu de navegação mobile" hidden>
  <header class="drawer-menu-cabecalho">
    <b class="logo-wordmark">Floria</b>
    <button type="button" class="drawer-fechar" id="drawer-fechar" aria-label="Fechar menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </header>
  <% var ROTAS_CATEGORIA_PROPRIA = ['plantas', 'vasos', 'ferramentas', 'adubos', 'controle-pragas']; %>
  <ul>
    <li><a href="/maisvendidos">Mais Vendidos</a></li>
    <% (locals.categoriasNav || []).forEach(function (c) { %>
      <li><a href="<%= ROTAS_CATEGORIA_PROPRIA.includes(c.slug) ? '/' + c.slug : '/categoria/' + c.slug %>"><%= c.nome %></a></li>
    <% }) %>
    <li><a href="/sobre-nos">Sobre Nós</a></li>
    <li><a href="/suporte">Suporte</a></li>
  </ul>
</nav>
