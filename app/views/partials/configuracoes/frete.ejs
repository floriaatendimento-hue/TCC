<%
const ufsEntregaSalvas = String(val('ufs_entrega_permitidas'))
  .split(',').map((uf) => uf.trim().toUpperCase()).filter(Boolean);
const TODAS_UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
%>
<article class="painel" aria-labelledby="config-secao-frete">
  <header class="painel__cabecalho">
    <h2 class="painel__titulo" id="config-secao-frete"><i class="fas fa-truck" aria-hidden="true"></i> Frete</h2>
    <p class="painel__subtitulo">Origem dos envios, região atendida e valores de frete.</p>
  </header>

    <fieldset class="form-secao">
      <legend><i class="fas fa-warehouse" aria-hidden="true"></i>Origem da loja</legend>
      <p class="form-secao__ajuda">Endereço de onde os pedidos saem: ponto de partida usado no cálculo de distância do frete.</p>
      <label class="campo-admin campo-cep-admin" for="cfg-cep-origem">
        <b>CEP de origem</b>
        <input id="cfg-cep-origem" placeholder="00000-000" maxlength="9" inputmode="numeric" value="<%= val('cep_origem') %>">
        <output id="cfg-cep-origem-status" class="cep-status-admin" aria-live="polite"></output>
      </label>
      <section class="form-admin__linha">
        <label class="campo-admin">
          <b>Logradouro</b>
          <input type="text" id="cfg-logradouro-origem" maxlength="150" value="<%= val('logradouro_origem') %>">
        </label>
        <label class="campo-admin">
          <b>Número</b>
          <input type="text" id="cfg-numero-origem" maxlength="20" value="<%= val('numero_origem') %>">
        </label>
      </section>
      <section class="form-admin__linha">
        <label class="campo-admin">
          <b>Bairro</b>
          <input type="text" id="cfg-bairro-origem" maxlength="100" value="<%= val('bairro_origem') %>">
        </label>
        <label class="campo-admin">
          <b>Cidade</b>
          <input type="text" id="cfg-cidade-origem" maxlength="100" value="<%= val('cidade_origem') %>">
        </label>
        <label class="campo-admin">
          <b>UF</b>
          <input type="text" id="cfg-uf-origem" maxlength="2" style="text-transform:uppercase" value="<%= val('uf_origem') %>">
        </label>
      </section>
    </fieldset>

    <fieldset class="form-secao">
      <legend><i class="fas fa-map-marked-alt" aria-hidden="true"></i>Área de entrega</legend>
      <p class="form-secao__ajuda">Estados atendidos pela loja. Nenhum selecionado = entrega liberada para todo o país.</p>
      <ul class="lista-ufs-entrega" id="lista-ufs-entrega">
        <% TODAS_UFS.forEach((uf) => { %>
          <li>
            <label>
              <input type="checkbox" class="js-uf-entrega" value="<%= uf %>" <%= ufsEntregaSalvas.includes(uf) ? 'checked' : '' %>>
              <%= uf %>
            </label>
          </li>
        <% }) %>
      </ul>
    </fieldset>

    <fieldset class="form-secao">
      <legend><i class="fas fa-sliders-h" aria-hidden="true"></i>Regras de entrega</legend>
      <p class="form-secao__ajuda">Valores usados quando o cálculo de frete em tempo real não está disponível.</p>
      <section class="form-admin__linha">
        <label class="campo-admin">
          <b>Frete padrão (R$)</b>
          <input type="number" id="cfg-frete-padrao" min="0" step="0.01" value="<%= val('frete_padrao') %>">
        </label>
        <label class="campo-admin">
          <b>Frete grátis a partir de (R$)</b>
          <input type="number" id="cfg-frete-gratis-acima" min="0" step="0.01" value="<%= val('frete_gratis_acima') %>">
          <small class="campo-admin__ajuda">Pedidos com valor igual ou maior não pagam frete.</small>
        </label>
      </section>
    </fieldset>
</article>
