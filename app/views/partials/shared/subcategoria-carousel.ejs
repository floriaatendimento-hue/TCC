<%
/* app/views/partials/subcategoria-carousel.ejs — uma seção "cards-section"
   com carrossel de produtos de UMA subcategoria. Recebe:
     - titulo:        nome da subcategoria (título da seção)
     - produtos:       produtos daquela subcategoria
     - categoriaNome:  nome da categoria (mostrado no card, igual ao já usado)
     - anchorId:       id único da seção (aria-labelledby)
   Markup idêntico ao carrossel de produtos já existente nas páginas de
   categoria — só reaproveita o mesmo componente (.cards-section /
   .carousel-wrapper / .cards-container / .card) uma vez por subcategoria,
   sem novo design. app/public/js/shared/carousel.js já inicializa qualquer
   .carousel-wrapper presente na página, então múltiplas instâncias
   funcionam sem alteração nenhuma no JS. */
%>
<section class="cards-section" aria-labelledby="<%= anchorId %>">
  <header class="section-label">
    <h2 id="<%= anchorId %>"><%= titulo %></h2>
  </header>
  <nav class="carousel-wrapper" aria-labelledby="<%= anchorId %>">
    <button class="carousel-btn" onclick="scrollCarousel(this,-1)" aria-label="Anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <ul class="cards-container">

      <% produtos.forEach(function (p) {
           var preco = p.preco_exibido;
           var precoFmt = 'R$ ' + Number(preco).toFixed(2).replace('.', ',');
           var href = '/' + (p.slug_pagina || p.slug);
      %>
      <li><article class="card card-home">
        <a href="<%= href %>">
          <figure>
            <img
              src="/imagens/<%= p.imagem || 'image.png' %>"
              alt="<%= p.nome %>"
              data-fallback="/imagens/image.png"
            >
            <button type="button" class="btn-favorito btn-favorito--card"
              data-slug="<%= p.slug_pagina || p.slug %>" data-nome="<%= p.nome %>"
              data-imagem="/imagens/<%= p.imagem || 'image.png' %>" data-preco="<%= preco %>"
              aria-label="Favoritar" aria-pressed="false">
              <i class="far fa-heart" aria-hidden="true"></i>
            </button>
          </figure>
          <section class="card-caption">
            <h3><%= p.nome %></h3><b class="card-categoria"><%= categoriaNome %></b><output class="card-rating" data-rating-slot="<%= p.slug_pagina || p.slug %>" data-rating-pendente><i class="card-rating-estrelas" aria-hidden="true"></i><b class="card-rating-qtd"></b></output>
            <p class="price"><%= precoFmt %></p>
          </section>
        </a>
        <footer class="card-footer"><button class="btn-comprar">Adicionar</button></footer>
      </article></li>
      <% }); %>

    </ul>
    <button class="carousel-btn" onclick="scrollCarousel(this,1)" aria-label="Próximo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
  </nav>
</section>
