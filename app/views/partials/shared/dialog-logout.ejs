<dialog id="dialog-logout" aria-labelledby="dialog-logout-titulo" aria-describedby="dialog-logout-texto">
  <h2 id="dialog-logout-titulo">Sair da conta?</h2>
  <p id="dialog-logout-texto" class="dialog-logout-texto">Tem certeza de que deseja sair da sua conta?</p>
  <menu>
    <li><button type="button" class="dialog-logout-cancelar" data-logout-cancelar>Cancelar</button></li>
    <li><button type="button" class="dialog-logout-confirmar" data-logout-confirmar>Sair</button></li>
  </menu>
</dialog>
