<section class="forca-senha forca-nivel-0" id="<%= secaoId %>" data-senha-forca="<%= alvoId %>" aria-live="polite">
  <ul class="forca-barras" aria-hidden="true">
    <li class="forca-barra"></li>
    <li class="forca-barra"></li>
    <li class="forca-barra"></li>
    <li class="forca-barra"></li>
  </ul>
  <p class="forca-rotulo">
    <b class="sr-only">Força da senha: </b><b class="forca-rotulo-texto">Vazia</b>
  </p>
  <ul class="forca-requisitos">
    <li class="requisito" data-requisito="tamanho">
      <i class="far fa-circle requisito-icone" aria-hidden="true"></i>
      <b>12 caracteres ou mais</b>
      <b class="sr-only requisito-estado"></b>
    </li>
    <li class="requisito" data-requisito="caixa">
      <i class="far fa-circle requisito-icone" aria-hidden="true"></i>
      <b>Letras maiúsculas e minúsculas</b>
      <b class="sr-only requisito-estado"></b>
    </li>
    <li class="requisito" data-requisito="numero">
      <i class="far fa-circle requisito-icone" aria-hidden="true"></i>
      <b>Um número</b>
      <b class="sr-only requisito-estado"></b>
    </li>
    <li class="requisito" data-requisito="simbolo">
      <i class="far fa-circle requisito-icone" aria-hidden="true"></i>
      <b>Um símbolo</b>
      <b class="sr-only requisito-estado"></b>
    </li>
  </ul>
</section>
