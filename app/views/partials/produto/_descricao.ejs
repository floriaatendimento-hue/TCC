<%
/* Partial: Descrição / Benefícios / Como Utilizar / Recomendações + ficha técnica.
   Locais esperados: descricao, beneficios, comoUtilizar, recomendacoes (strings, opcionais
   exceto descricao), ficha (array de { rotulo, valor }, opcional) */
%>
<section class="descricao" aria-labelledby="lbl-desc">
  <article class="descricao-inner descricao-grid">
    <section class="descricao-texto">
      <h2 id="lbl-desc">Descrição</h2>
      <p><%= descricao || 'Sem descrição disponível para este produto.' %></p>
      <% if (beneficios) { %>
        <h3>Benefícios</h3>
        <p><%= beneficios %></p>
      <% } %>
      <% if (comoUtilizar) { %>
        <h3>Como Utilizar</h3>
        <p><%= comoUtilizar %></p>
      <% } %>
      <% if (recomendacoes) { %>
        <h3>Recomendações</h3>
        <p><%= recomendacoes %></p>
      <% } %>
    </section>
    <% if (ficha && ficha.length) { %>
    <aside class="ficha-tecnica" aria-label="Ficha técnica">
      <dl>
        <% ficha.forEach(function (item) { %>
          <dt><%= item.rotulo %></dt><dd><%= item.valor %></dd>
        <% }); %>
      </dl>
    </aside>
    <% } %>
  </article>
</section>
