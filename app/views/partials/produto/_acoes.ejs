<%
/* Partial: botões de ação (Adicionar ao Carrinho, Comprar Agora, Favoritar).
   Locais esperados: slug, nome, imagemPrincipal, precoAtual, estoque, categoriaSlug */
var esgotado = estoque === 0;
var CATEGORIAS_COM_GUIA = ['plantas', 'adubos', 'controle-pragas'];
var temGuia = CATEGORIAS_COM_GUIA.indexOf(categoriaSlug) !== -1;
%>
<p class="acao-produto">
  <% if (esgotado) { %>
  <button class="btn-add" type="button" disabled aria-disabled="true">Produto esgotado</button>
  <button class="btn-comprar-agora" type="button" disabled aria-disabled="true">Comprar Agora</button>
  <% } else { %>
  <button class="btn-add" type="button">
    <i class="fas fa-shopping-cart" aria-hidden="true"></i>&nbsp; Adicionar ao carrinho
  </button>
  <button class="btn-comprar-agora" type="button">
    <i class="fas fa-bolt" aria-hidden="true"></i>&nbsp; Comprar Agora
  </button>
  <% } %>
  <button type="button" class="btn-favorito btn-favorito--grande"
    data-slug="<%= slug %>" data-nome="<%= nome %>"
    data-imagem="<%= imagemPrincipal %>" data-preco="<%= precoAtual %>"
    aria-label="Favoritar" aria-pressed="false"><i class="far fa-heart" aria-hidden="true"></i></button>
</p>
<% if (temGuia) { %>
<p class="acao-guia-produto">
  <a class="btn-guia-pdf" href="/produto/<%= slug %>/guia.pdf?baixar=1">
    <i class="fas fa-file-pdf" aria-hidden="true"></i>&nbsp; Baixar guia de utilização (PDF)
  </a>
</p>
<% } %>
