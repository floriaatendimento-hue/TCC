<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acesso negado - Floria</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/erro-pagina.css">
</head>
<body>
  <%- include("../partials/layout/header") %>
  <%- include("../partials/layout/nav") %>

  <main>
    <section class="pagina-erro" aria-labelledby="erro-titulo">
      <p class="pagina-erro-codigo" aria-hidden="true">403</p>

      <h1 id="erro-titulo">Acesso não autorizado</h1>
      <p class="pagina-erro-texto">
        Você não tem permissão para acessar esta página.
      </p>

      <section class="pagina-erro-acoes">
        <a href="/" class="btn-ver-mais pagina-erro-btn-primario">
          <i class="fas fa-home" aria-hidden="true"></i>
          Voltar para a página inicial
        </a>
        <a href="/perfil#pedidos" class="pagina-erro-link-secundario">
          Ver meus pedidos
        </a>
      </section>

      <button type="button" class="pagina-erro-voltar">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        Voltar
      </button>
    </section>
  </main>

  <%- include("../partials/layout/footer") %>
  <script src="/js/shared/erro-pagina.js" defer></script>
</body>
</html>
